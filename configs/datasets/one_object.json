{
  "schema_version": "physweep_dataset_build_v1",
  "dataset_id": "physweep_one_object",
  "release_root": "datasets/one_object_sweep",
  "scope": {
    "phase": "base_and_sweep_metadata",
    "source_base_count": 3200,
    "source_base_seed": 20260905,
    "sweep_axes": ["mass_kg", "contact_friction", "contact_restitution"],
    "values_per_axis": 5,
    "canonical_base_axis": "mass_kg",
    "unique_samples_per_base": 13
  },
  "stages": [
    {
      "name": "sample_base",
      "command": [
        "{python}",
        "-m",
        "tools.sampling.sample_one_object_scene_matrix",
        "--root",
        "{root}",
        "--output-dataset",
        "one_object_base",
        "--count",
        "3200",
        "--seed",
        "20260905",
        "--resolution",
        "1280",
        "720",
        "--samples",
        "16",
        "--physics-workers",
        "32"
      ]
    },
    {
      "name": "derive_sweep",
      "command": [
        "{python}",
        "-m",
        "tools.sampling.derive_physics_sweep",
        "--root",
        "{root}",
        "--config",
        "configs/physics_sweep.json",
        "--base-manifest",
        "datasets/one_object_base/manifest.json",
        "--output-dir",
        "datasets/one_object_sweep/metadata"
      ]
    }
  ]
}
