{
  "version": "physweep_object_bound_sweep_v2",
  "scope": "immutable_object_bound_one_factor_multi_schema_derivation",
  "base_schema_versions": [
    "physweep_pybullet_rigid_metadata_v1",
    "physweep_asset_proxy_scene_v3",
    "physweep_billiards_scene_v4",
    "physweep_passive_pinball_scene_v1",
    "physweep_marble_run_scene_v1"
  ],
  "backend_contract": "physweep_resolved_simulation_scene_v1",
  "canonical_base_axis": "mass_kg",
  "max_dynamic_objects": 3,
  "object_binding_path": "object_identity.objects[role=dynamic]",
  "object_id_policy": "required_object_id",
  "prior_sources": {
    "physassets_profiles": "configs/physassets_core_object_profiles.json",
    "asset_proxy_registry": "configs/asset_proxy_registry.json",
    "billiards_backend": "configs/pybullet_backend.json",
    "passive_pinball_backend": "configs/passive_pinball_backend.json",
    "marble_run_backend": "configs/marble_run_backend.json",
    "marble_run_candidate": "configs/candidates/marble_run_v1.json",
    "specialized_scene_backends": "configs/specialized_scene_backends.json"
  },
  "endpoint_policy": {
    "algorithm": "intersect_domains_then_interpolate",
    "domain_sources": [
      "axis_runtime_or_asset_domain",
      "base_relative_span",
      "optional_axis_motion_bound"
    ],
    "normalized_positions": [0.0, 0.25, 0.5, 0.75, 1.0],
    "base_value_policy": "preserve_exactly_at_middle_position",
    "edge_policy": "reject_if_middle_impossible",
    "interpolation_policy": "axis_scale"
  },
  "axes": {
    "mass_kg": {
      "object_field": "material.mass_kg",
      "level_count": 5,
      "level_positions": [0.0, 0.25, 0.5, 0.75, 1.0],
      "domain_policy": "asset_mass_range_then_base_relative_fallback",
      "range_policy": {
        "mode": "relative_multipliers",
        "lower_multiplier": 0.5,
        "upper_multiplier": 2.0
      },
      "scale": "log"
    },
    "contact_friction": {
      "object_field": "material.contact_friction",
      "level_count": 5,
      "level_positions": [0.0, 0.25, 0.5, 0.75, 1.0],
      "domain": [0.02, 1.0],
      "domain_policy": "runtime_domain_with_transition_crossing",
      "transition_margin": 1.25,
      "range_policy": {
        "mode": "relative_multipliers",
        "lower_multiplier": 0.25,
        "upper_multiplier": 3.5
      },
      "scale": "linear"
    },
    "contact_restitution": {
      "object_field": "material.contact_restitution",
      "level_count": 5,
      "level_positions": [0.0, 0.25, 0.5, 0.75, 1.0],
      "domain": [0.0, 0.8],
      "schema_domains": {
        "physweep_billiards_scene_v4": [0.3, 1.0],
        "physweep_passive_pinball_scene_v1": [0.18, 0.98]
      },
      "domain_policy": "schema_stable_runtime_domain",
      "semantic_control": "elasticity",
      "range_policy": {
        "mode": "global"
      },
      "scale": "linear"
    }
  },
  "unsupported_axes": [
    "youngs_modulus_pa",
    "linear_damping",
    "angular_damping",
    "rolling_friction",
    "spinning_friction"
  ],
  "invariants": [
    "base metadata is never modified",
    "the canonical base is stored once without a target object or sweep parameter",
    "one derived record changes exactly one runtime material field on exactly one target object",
    "target object is identified by stable object id and index",
    "all dynamic object physical states are serialized in the derived metadata",
    "non-target objects remain byte-equivalent in their runtime material state",
    "geometry, visual bindings, support, camera, render request, and initial state are copied unchanged",
    "no post-frame-zero force or steering is added",
    "unsupported axes are rejected instead of silently approximated"
  ]
}
