* text=auto eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.glb binary
*.npz binary
*.pt binary
*.pth binary
*.safetensors binary
# Runtime provenance binds raw file bytes, including line endings. Preserve them
# in both checkouts and source archives so frozen checksums remain portable.
*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/configs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/assets/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
